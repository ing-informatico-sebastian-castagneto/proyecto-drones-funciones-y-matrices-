{
  "server": {
    "host": "127.0.0.1",
    "port": 8000,
    "reload": false
  },
  "upload": {
    "max_bytes": 10485760,
    "max_image_pixels": 16000000,
    "max_image_dimension": 4096,
    "content_types": [
      "image/png",
      "image/jpeg",
      "image/webp"
    ]
  },
  "processing": {
    "min_zoom": 1.0,
    "max_zoom": 8.0,
    "zoom_step": 0.5,
    "default_zoom": 3.0,
    "min_gamma": 0.1,
    "max_gamma": 4.0,
    "gamma_step": 0.1,
    "default_gamma": 2.0
  },
  "live_view": {
    "enabled": true,
    "source": "synthetic",
    "interval_ms": 3000
  },
  "assistants": {
    "mode": "local",
    "count": 2,
    "max_source_chars": 50000
  }
}
